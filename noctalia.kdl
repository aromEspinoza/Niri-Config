layout {

    focus-ring {
        active-color   "#aaccda"
        inactive-color "#121414"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#aaccda"
        inactive-color "#121414"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#aaccda"
        inactive-color "#43636f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#aaccda80"
    }
}

recent-windows {
    highlight {
        active-color "#aaccda"
        urgent-color "#ffb4ab"
    }
}
