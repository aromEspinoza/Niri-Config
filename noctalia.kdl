layout {

    focus-ring {
        active-color   "#d3beef"
        inactive-color "#141316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d3beef"
        inactive-color "#141316"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d3beef"
        inactive-color "#5a4973"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d3beef80"
    }
}

recent-windows {
    highlight {
        active-color "#d3beef"
        urgent-color "#ffb4ab"
    }
}
